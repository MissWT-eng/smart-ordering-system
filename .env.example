# 复制成 .env 再填真实值：cp .env.example .env
# .env 已在 .gitignore 里，不会被提交

# MySQL root 密码（自己设一个，别用 123456）
MYSQL_ROOT_PASSWORD=please-change-me

# DeepSeek 对话模型
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# BGE-M3 向量模型（SiliconFlow）
BGE_M3_API_KEY=sk-xxxxxxxxxxxxxxxx

# 和风天气（base-url 填你自己账号对应的专属域名）
QWEATHER_API_KEY=xxxxxxxxxxxxxxxx
QWEATHER_BASE_URL=https://xxxxxxxx.re.qweatherapi.com

# 商户端接口令牌（自己生成一串随机字符即可）
ADMIN_TOKEN=please-change-me

# 语音能力（不用就留空）
ALIYUN_SPEECH_BASE_URL=
DASHSCOPE_API_KEY=
